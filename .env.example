# Copy this to .env at the repository root. Never commit .env.
# Submission uses firestore. For local UI/CRUD checks only, choose sqlite.
STORAGE_BACKEND=firestore
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.4-mini
# Codyssey virtual key: use this gateway, not api.openai.com.
OPENAI_BASE_URL=https://copa.codyssey.kr/v1
# Option A (Render): entire service-account JSON on one line, enclosed in single quotes.
FIREBASE_SERVICE_ACCOUNT_JSON=
# Option B (local): absolute path to the service-account JSON file.
FIREBASE_SERVICE_ACCOUNT_PATH=
# No trailing slash; add the exact Vercel origin after deployment.
ALLOWED_ORIGINS=http://localhost:5500,http://127.0.0.1:5500
# Public frontend build variable; also set this in Vercel, not a secret.
API_BASE_URL=http://127.0.0.1:8000
